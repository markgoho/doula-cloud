# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

.angular


# Firebase
*-debug.log
.firebase


# Hugo
hugo/public
hugo/resources
hugo/.hugo_build.lock
# Generated by scripts/sync-practice-pages.ts from the database on every
# build (#441). A committed copy would go stale the moment a Practice
# republished, and the sync prunes the whole tree before writing it.
hugo/content/p/
# Env — never commit a key, test-mode or otherwise. app/.gitignore
# carries the same rule for app/.env.local, which is where the Stripe
# test-mode values live for `bun run dev:full` (see docs/environment.md).
.env
.env.*
!.env.example
