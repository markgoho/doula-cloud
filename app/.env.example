# Copy to app/.env.local and fill in. bun auto-loads .env.local for
# `bun run dev:full`, and app/e2e/stack.ts passes the whole environment
# through to the Go BFF it starts. app/.gitignore excludes .env.local:
# nothing below belongs in git, test mode or not.
#
# `bash scripts/stripe-setup.sh` writes every one of these for you.
# See docs/environment.md for what each is and where it lives elsewhere.

# The account owner's address. Not read by any code; recorded so the run
# is traceable back to a mailbox.
STRIPE_ACCOUNT_EMAIL=mark@doula.cloud

# One platform secret key, test mode. Serves both Stripe surfaces.
STRIPE_API_KEY=sk_test_...

# The Price id for one Engagement credit. Checkout multiplies it by the
# quantity bought.
STRIPE_CREDIT_PRICE_ID=price_...

# Both hold the SAME value locally: one `stripe listen` session signs
# everything it forwards with its own single secret, whether the event
# goes to --forward-to or --forward-connect-to. Deployed, they are two
# different secrets from two different endpoints.
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Optional. Defaults to the origin the local stack is started for
# (http://localhost:5173 for dev:full). Override only for a tunnelled walk.
# APP_BASE_URL=http://localhost:5173

# Written by scripts/stripe-setup.sh at the moment each deployed webhook
# endpoint is created. Stripe returns a signing secret once and never
# again, so these are kept here as the only local copy. The BFF never
# reads them; Secret Manager holds the values the deployed service uses.
DEPLOYED_STRIPE_WEBHOOK_SECRET=whsec_...
DEPLOYED_STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
