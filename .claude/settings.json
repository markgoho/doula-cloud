{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh issue edit *)",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/mark-ac-verified.sh\"",
            "statusMessage": "Recording AC re-verification"
          },
          {
            "type": "command",
            "if": "Bash(git worktree add*)",
            "command": "bun \"$(git rev-parse --show-toplevel)/.claude/hooks/worktree-provision.ts\"",
            "statusMessage": "Provisioning a manually created worktree",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh issue close *)",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/gate-issue-close.sh\"",
            "statusMessage": "Checking AC re-verification before close"
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/gate-shared-index.sh\"",
            "statusMessage": "Checking this is safe against a shared index"
          },
          {
            "type": "command",
            "if": "Bash(*golangci-lint*)",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/gate-golangci-lint-cache.sh\"",
            "statusMessage": "Checking golangci-lint's cache is scoped to this worktree"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/.claude/hooks/gate-worktree-edit.ts\"",
            "statusMessage": "Checking this file isn't tracked in the main checkout",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/.claude/hooks/worktree-prune.ts\" --merged",
            "statusMessage": "Removing worktrees whose work has landed",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/.claude/hooks/gate-worktree-cleanup.ts\"",
            "statusMessage": "Checking whether this worktree has landed",
            "timeout": 15
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/.claude/hooks/worktree-create.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
