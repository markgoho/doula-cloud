#!/bin/sh
# Pre-commit hook for doula-cloud. Enabled per-clone via:
#   git config core.hooksPath scripts/hooks
# See docs/testing.md for details.

# 1. Blocks a commit that stages unformatted Go files
staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -n "$staged_go_files" ]; then
    unformatted=$(gofmt -l $staged_go_files)
    if [ -n "$unformatted" ]; then
        echo "gofmt: the following staged Go files are not formatted:" >&2
        echo "$unformatted" >&2
        echo "Run 'gofmt -w <file>', re-stage, and commit again." >&2
        exit 1
    fi
fi

# 2. Blocks a commit with typecheck or lint errors when app/ files are staged
staged_app_files=$(git diff --cached --name-only --diff-filter=ACM -- 'app/*')
if [ -n "$staged_app_files" ]; then
    echo "Running SvelteKit typecheck and lint on app/..." >&2
    bun run --cwd app check || exit 1
    bun run --cwd app lint || exit 1

    # 3. Blocks a commit that breaks the design brief's smoothness rules
    #    (#418): the motion gate, the unbounded-list gate, and the
    #    per-row budgets all live in the unit suite. It runs here rather
    #    than only in CI because the brief's own argument is that a
    #    commitment nobody measures decays, and the cheapest place to
    #    measure is before the commit exists. Measured on an idle 14-CPU
    #    machine: ~16s and a ~4.9GB peak for 2689 tests at 100% coverage.
    #    Most of that peak is headless Chromium, because app/vite.config.ts
    #    runs its `client` project in browser mode -- see the maxWorkers
    #    comment there for why the browser pool is capped (#935). The
    #    Playwright e2e suite deliberately stays out, since it builds the
    #    app and starts Postgres, the BFF and an emulator.
    #    Only one session at a time may run this step (#936). Capping the
    #    pool got two concurrent gates onto a 24GB machine; the ~3.5GB of
    #    fixed cost per gate that no worker count removes is why a third
    #    needs admission control instead. scripts/gate-lock.ts holds a
    #    machine-wide lock across every worktree and fails open on every
    #    error path -- see docs/testing.md.
    #
    #    $0 is this hook's absolute path in the MAIN checkout
    #    (core.hooksPath is absolute), while the working directory is the
    #    committing worktree. Resolving the wrapper from $0 rather than
    #    the cwd is what lets a worktree branched before #936 landed still
    #    commit, and the -f test is the same guard once more: no wrapper,
    #    no lock, but never a blocked commit.
    echo "Running unit tests and the coverage gate on app/..." >&2
    gate_lock="$(dirname "$0")/../gate-lock.ts"
    if [ -f "$gate_lock" ]; then
        bun "$gate_lock" -- bun run --cwd app test:unit:coverage || exit 1
    else
        bun run --cwd app test:unit:coverage || exit 1
    fi
fi

# 4. Blocks a commit that stages an unformatted .ts file in either of the
#    repo's own tooling trees, .claude/hooks/ and scripts/ (#1120). Same
#    shape as step 1, and for the same reason. What the rule is and why
#    these two trees needed a gate is in docs/testing.md's "Formatting"
#    section; the CI `format` job is the backstop, and this is the fast
#    local half of it, over staged files only.
#
#    Prettier is resolved from the repo root rather than the working
#    directory, since a worktree's root node_modules is usually a symlink
#    to the main checkout's. If it is missing, the commit is blocked
#    rather than passed silently -- a formatting gate that quietly skips
#    itself is the state this replaced -- and the message has to name the
#    checkout to install in, which through a symlink is the main one:
#    `bun install` inside a worktree with a live symlink would mutate the
#    modules every other worktree is sharing (docs/agents/worktree-flow.md).
staged_tooling_ts=$(git diff --cached --name-only --diff-filter=ACM -- '.claude/hooks/*.ts' 'scripts/*.ts')
if [ -n "$staged_tooling_ts" ]; then
    repo_root=$(git rev-parse --show-toplevel)
    prettier="$repo_root/node_modules/.bin/prettier"
    if [ ! -x "$prettier" ]; then
        install_root="$repo_root"
        if [ -L "$repo_root/node_modules" ]; then
            install_root=$(dirname "$(readlink "$repo_root/node_modules")")
        fi
        echo "prettier: not installed, so the tooling-tree formatting gate" >&2
        echo "cannot run. Run 'bun install' in $install_root" >&2
        echo "and commit again." >&2
        exit 1
    fi
    if ! "$prettier" --check $staged_tooling_ts >&2; then
        echo "The staged files above are not formatted. Run 'bun run format'" >&2
        echo "at the repo root, re-stage, and commit again." >&2
        exit 1
    fi
fi
