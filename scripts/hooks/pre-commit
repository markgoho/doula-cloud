#!/bin/sh
# Blocks a commit that stages unformatted Go files. Enabled per-clone via:
#   git config core.hooksPath scripts/hooks
# See docs/testing.md for details -- gofmt is not run automatically by any
# other tool in this repo (not golangci-lint, not CI), so this hook and
# the CI format-check step are the only two places it's enforced.

staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -z "$staged_go_files" ]; then
    exit 0
fi

unformatted=$(gofmt -l $staged_go_files)
if [ -n "$unformatted" ]; then
    echo "gofmt: the following staged Go files are not formatted:" >&2
    echo "$unformatted" >&2
    echo "Run 'gofmt -w <file>', re-stage, and commit again." >&2
    exit 1
fi
