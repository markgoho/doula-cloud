{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["es2023"],
    "module": "NodeNext",
    "moduleResolution": "node16",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022"
  },
  "compileOnSave": true,
  "include": ["src"]
}
